# Backend only. Copy to .env; never add VITE_ to secret names.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Verlyn HQ

# Local development binds to this computer by default.
HOST=127.0.0.1
PORT=3000
# Network hosting requires the exact browser origin and a strong, unique
# password (24+ characters). Visitors use this password in AI settings.
# APP_ORIGIN=https://office.example.com
APP_ACCESS_TOKEN=
