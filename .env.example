# Antigravity uses its official local sign-in and private credential storage.
# Run agy to sign in; agy models must include gemini-3.8-flash-low and gemini-3.8-flash-medium.
# The website never needs your Google password or a provider API key.
HOST=127.0.0.1
PORT=3000
# Optional if agy is not on the server PATH:
# ANTIGRAVITY_BIN=C:/path/to/agy.exe

# Network hosting requires an exact browser origin and a unique 24+ character
# office access password. This password is separate from Google sign-in.
# HOST=0.0.0.0
# APP_ORIGIN=https://office.example.com
APP_ACCESS_TOKEN=
