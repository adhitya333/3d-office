# Official local sign-ins; no provider API keys are required.
# Run codex login, choose ChatGPT, and confirm with codex login status.
# Run agy to sign in with Google; agy models confirms available Gemini models.
# The website never needs either provider password or copies of their credentials.
HOST=127.0.0.1
PORT=3000
# Optional if agy is not on the server PATH:
# ANTIGRAVITY_BIN=C:/path/to/agy.exe
# CODEX_BIN=C:/path/to/codex.exe

# Network hosting requires an exact browser origin and a unique 24+ character
# office access password. This password is separate from provider sign-in.
# HOST=0.0.0.0
# APP_ORIGIN=https://office.example.com
APP_ACCESS_TOKEN=
